import Submission.ComplexProjectivePlaneMinimalHopfBallCollapse

/-!
# Relative collapse of the punctured finite Hopf ball onto its boundary

Removing the distinguished all-interior four-simplex from the seventeen-vertex ambient complex
leaves a finite cylinder between that simplex boundary and the original twelve-vertex finite
Hopf domain.  This file certifies one side of that cylinder: 252 elementary collapses reduce the
punctured ambient complex to a presentation of the original 36-tetrahedron boundary sphere.
Every free face lies outside every protected boundary facet.
-/

noncomputable section

open Submission
open Submission.FiniteOrderedComplex

namespace Submission.ComplexProjectivePlaneTriangulation

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

/-- The ambient finite Hopf complex with the distinguished interior four-simplex removed. -/
def minimalHopfBallPuncturedFacets :
    Finset (Finset MinimalHopfBallVertex) :=
  minimalHopfBallFacets.erase {0, 1, 2, 3, 4}

