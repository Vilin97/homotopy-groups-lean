/-- The four-zero section is a right inverse of the induced fundamental-group map. -/
theorem fourZeroCentralInterfaceInclPairwisePiOneSection_rightInverse :
    (HomotopyGroup.mapHom (N := Fin 1)
        (SSet.toTop.map fourZeroCentralInterfaceInclPairwise).hom
        fourZeroCentralRealizationBase_map_pairwise_eq).comp
      fourZeroCentralInterfaceInclPairwisePiOneSection =
    MonoidHom.id _ := by
  ext h
