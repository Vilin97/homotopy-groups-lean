import Submission.ComplexProjectivePlaneTrisectionMeridianQuotients

/-!
# Splittings of the trisection fundamental-group sequences

A surjection with cyclic kernel generated by a class of unit integral coordinate is jointly
classified by that coordinate and the surjection.  Applying this observation to the three
central-to-pairwise maps gives explicit product decompositions

`pi_1(T^2) = Z x pi_1(S^1)`.

In each decomposition the named meridian is the positive generator of the integer factor and
the original induced map is the second projection.  Taking the inverse image of the second
factor therefore supplies a homomorphic right inverse, so all three short exact sequences split.
-/

noncomputable section

open CategoryTheory Simplicial
open scoped Topology Topology.Homotopy

namespace Submission

/-- A surjection and an integer coordinate jointly classify the source when its kernel is
generated by a class of coordinate one. -/
theorem monoidHom_prod_bijective_of_surjective_of_ker_eq_zpowers_of_apply_eq_one
    {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f)
    (coordinate : G →* Multiplicative ℤ) (g : G)
    (hker : f.ker = Subgroup.zpowers g)
    (hcoordinate : coordinate g = Multiplicative.ofAdd (1 : ℤ)) :
    Function.Bijective (coordinate.prod f) := by
  have hfg : f g = 1 := by
    rw [← MonoidHom.mem_ker, hker]
    exact Subgroup.mem_zpowers g
  constructor
  · intro x y hxy
    have hcoordinateXY : coordinate x = coordinate y :=
      congrArg Prod.fst hxy
    have hfXY : f x = f y := congrArg Prod.snd hxy
    have hxyMem : x * y⁻¹ ∈ f.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hfXY, mul_inv_cancel]
    rw [hker] at hxyMem
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hxyMem
    have hcoordinateOne : coordinate (x * y⁻¹) = 1 := by
      rw [map_mul, map_inv, hcoordinateXY, mul_inv_cancel]
    rw [← hn, map_zpow, hcoordinate] at hcoordinateOne
    have hnZero : n = 0 := by
      have h := congrArg Multiplicative.toAdd hcoordinateOne
      simpa using h
    apply mul_inv_eq_one.mp
    rw [← hn, hnZero, zpow_zero]
  · rintro ⟨z, h⟩
    obtain ⟨y, hy⟩ := hf h
    let n : ℤ := z.toAdd - (coordinate y).toAdd
    refine ⟨g ^ n * y, ?_⟩
    apply Prod.ext
    · change coordinate (g ^ n * y) = z
      rw [map_mul, map_zpow, hcoordinate]
      apply Multiplicative.toAdd.injective
      simp [n]
    · change f (g ^ n * y) = h
      rw [map_mul, map_zpow, hfg, one_zpow, one_mul, hy]

/-- The multiplicative equivalence jointly induced by an integral coordinate and a surjection
whose kernel is generated by a class of coordinate one. -/
noncomputable def monoidHomProdMulEquivOfSurjectiveOfKerEqZPowersOfApplyEqOne
    {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f)
    (coordinate : G →* Multiplicative ℤ) (g : G)
    (hker : f.ker = Subgroup.zpowers g)
    (hcoordinate : coordinate g = Multiplicative.ofAdd (1 : ℤ)) :
    G ≃* Multiplicative ℤ × H :=
  MulEquiv.ofBijective (coordinate.prod f)
    (monoidHom_prod_bijective_of_surjective_of_ker_eq_zpowers_of_apply_eq_one
      f hf coordinate g hker hcoordinate)

end Submission

namespace Submission.ComplexProjectivePlaneTriangulation

open FiniteOrderedComplex

/-- The zero-five central fundamental group decomposes into its meridian coordinate and the
pairwise fundamental group. -/
noncomputable def zeroFiveCentralInterfacePiOneMeridianProdEquiv :
    HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet centralInterfaceFacets))
        zeroFiveCentralRealizationBase ≃*
      Multiplicative ℤ ×
        HomotopyGroup.Pi 1
          (SSet.toTop.obj (orderedSSet (pairwiseInterfaceFacets 0 5)))
          ((SSet.toTop.map
            (zeroFiveMeridianBoundaryInclCentral ≫
              zeroFiveCentralInterfaceInclPairwise)).hom
            zeroFiveBoundaryRealizationBase) :=
  monoidHomProdMulEquivOfSurjectiveOfKerEqZPowersOfApplyEqOne
    (HomotopyGroup.mapHom (N := Fin 1)
      (SSet.toTop.map zeroFiveCentralInterfaceInclPairwise).hom
      zeroFiveCentralRealizationBase_map_pairwise_eq)
    zeroFiveCentralInterfaceInclPairwise_piOne_map_surjective
    zeroFiveCentralRealizationPiOneFirstCoordinate
    zeroFiveCentralRealizationPiOneClass
    zeroFiveCentralInterfaceInclPairwise_piOne_ker_eq_zpowers
    zeroFiveCentralRealizationPiOneFirstCoordinate_class

/-- The zero-five product decomposition sends its meridian to the positive integer generator. -/
theorem zeroFiveCentralInterfacePiOneMeridianProdEquiv_meridian :
    zeroFiveCentralInterfacePiOneMeridianProdEquiv
        zeroFiveCentralRealizationPiOneClass =
      (Multiplicative.ofAdd (1 : ℤ), 1) := by
  apply Prod.ext
  · exact zeroFiveCentralRealizationPiOneFirstCoordinate_class
  · exact zeroFiveCentralInterfaceInclPairwise_piOne_map_class_eq_one

/-- A homomorphic section of the zero-five central-to-pairwise fundamental-group map. -/
noncomputable def zeroFiveCentralInterfaceInclPairwisePiOneSection :
    HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet (pairwiseInterfaceFacets 0 5)))
        ((SSet.toTop.map
          (zeroFiveMeridianBoundaryInclCentral ≫
            zeroFiveCentralInterfaceInclPairwise)).hom
          zeroFiveBoundaryRealizationBase) →*
      HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet centralInterfaceFacets))
        zeroFiveCentralRealizationBase :=
  zeroFiveCentralInterfacePiOneMeridianProdEquiv.symm.toMonoidHom.comp
    (MonoidHom.inr (Multiplicative ℤ) _)

/-- The zero-five section is a right inverse of the induced fundamental-group map. -/
theorem zeroFiveCentralInterfaceInclPairwisePiOneSection_rightInverse :
    (HomotopyGroup.mapHom (N := Fin 1)
        (SSet.toTop.map zeroFiveCentralInterfaceInclPairwise).hom
        zeroFiveCentralRealizationBase_map_pairwise_eq).comp
      zeroFiveCentralInterfaceInclPairwisePiOneSection =
    MonoidHom.id _ := by
  ext h
  have hpair :=
    zeroFiveCentralInterfacePiOneMeridianProdEquiv.apply_symm_apply (1, h)
  exact congrArg Prod.snd hpair

