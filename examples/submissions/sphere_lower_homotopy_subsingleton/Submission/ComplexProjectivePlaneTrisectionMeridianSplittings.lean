/-- The sign-normalized integer coordinate on the four-zero meridian. -/
noncomputable def fourZeroCentralRealizationPiOneMeridianCoordinate :
    HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet centralInterfaceFacets))
        fourZeroCentralRealizationBase →*
      Multiplicative ℤ :=
  (AddEquiv.neg ℤ).toMultiplicative.toMonoidHom.comp
    fourZeroCentralRealizationPiOneFirstCoordinate

/-- The normalized four-zero meridian coordinate is positive one. -/
theorem fourZeroCentralRealizationPiOneMeridianCoordinate_class :
    fourZeroCentralRealizationPiOneMeridianCoordinate
        fourZeroCentralRealizationPiOneClass =
      Multiplicative.ofAdd (1 : ℤ) := by
  rw [fourZeroCentralRealizationPiOneMeridianCoordinate,
    MonoidHom.comp_apply,
    fourZeroCentralRealizationPiOneFirstCoordinate_class]
  rfl

/-- The four-zero central fundamental group decomposes into its normalized meridian coordinate
and the pairwise fundamental group. -/
noncomputable def fourZeroCentralInterfacePiOneMeridianProdEquiv :
    HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet centralInterfaceFacets))
        fourZeroCentralRealizationBase ≃*
      Multiplicative ℤ ×
        HomotopyGroup.Pi 1
          (SSet.toTop.obj (orderedSSet (pairwiseInterfaceFacets 4 0)))
          ((SSet.toTop.map
            (fourZeroMeridianBoundaryInclCentral ≫
              fourZeroCentralInterfaceInclPairwise)).hom
            fourZeroBoundaryRealizationBase) :=
  monoidHomProdMulEquivOfSurjectiveOfKerEqZPowersOfApplyEqOne
    (HomotopyGroup.mapHom (N := Fin 1)
      (SSet.toTop.map fourZeroCentralInterfaceInclPairwise).hom
      fourZeroCentralRealizationBase_map_pairwise_eq)
    fourZeroCentralInterfaceInclPairwise_piOne_map_surjective
    fourZeroCentralRealizationPiOneMeridianCoordinate
    fourZeroCentralRealizationPiOneClass
    fourZeroCentralInterfaceInclPairwise_piOne_ker_eq_zpowers
    fourZeroCentralRealizationPiOneMeridianCoordinate_class

/-- The four-zero product decomposition sends its meridian to the positive integer generator. -/
theorem fourZeroCentralInterfacePiOneMeridianProdEquiv_meridian :
    fourZeroCentralInterfacePiOneMeridianProdEquiv
        fourZeroCentralRealizationPiOneClass =
      (Multiplicative.ofAdd (1 : ℤ), 1) := by
  apply Prod.ext
  · exact fourZeroCentralRealizationPiOneMeridianCoordinate_class
  · exact fourZeroCentralInterfaceInclPairwise_piOne_map_class_eq_one

/-- A homomorphic section of the four-zero central-to-pairwise fundamental-group map. -/
noncomputable def fourZeroCentralInterfaceInclPairwisePiOneSection :
    HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet (pairwiseInterfaceFacets 4 0)))
        ((SSet.toTop.map
          (fourZeroMeridianBoundaryInclCentral ≫
            fourZeroCentralInterfaceInclPairwise)).hom
          fourZeroBoundaryRealizationBase) →*
      HomotopyGroup.Pi 1
        (SSet.toTop.obj (orderedSSet centralInterfaceFacets))
