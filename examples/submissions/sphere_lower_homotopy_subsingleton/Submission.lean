theorem sphere_lower_homotopy_subsingleton (n k : ℕ) (hk : k < n) :
    Subsingleton
      (HomotopyGroup.Pi k (SphereSpace n) (sphereBasepoint n)) := by
  exact subsingleton_homotopyGroup_sphere_of_lt k n hk (sphereBasepoint n)

